{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/case-tecnologia{/}?",
      "has": [
        {
          "type": "host",
          "value": "blog.origamilab.com.br"
        }
      ],
      "destination": "https://www.origamilab.com.br/cases/prumo-engenharia",
      "permanent": true
    },
    {
      "source": "/case-transportadora-cabral{/}?",
      "has": [
        {
          "type": "host",
          "value": "blog.origamilab.com.br"
        }
      ],
      "destination": "https://www.origamilab.com.br/cases/transportadora-cabral",
      "permanent": true
    },
    {
      "source": "/cases{/}?",
      "has": [
        {
          "type": "host",
          "value": "blog.origamilab.com.br"
        }
      ],
      "destination": "https://www.origamilab.com.br/cases",
      "permanent": true
    },
    {
      "source": "/category/cases{/}?",
      "has": [
        {
          "type": "host",
          "value": "blog.origamilab.com.br"
        }
      ],
      "destination": "https://www.origamilab.com.br/cases",
      "permanent": true
    },
    {
      "source": "/como-mensurar-o-retorno-sobre-investimento-em-inovacao{/}?",
      "has": [
        {
          "type": "host",
          "value": "blog.origamilab.com.br"
        }
      ],
      "destination": "https://www.origamilab.com.br/planejamento-de-producao#roi",
      "permanent": true
    },
    {
      "source": "/ia-na-industria-casos-de-uso{/}?",
      "has": [
        {
          "type": "host",
          "value": "blog.origamilab.com.br"
        }
      ],
      "destination": "https://www.origamilab.com.br/gestao-industrial-em-tempo-real#ia",
      "permanent": true
    },
    {
      "source": "/category/ia-aplicada{/}?",
      "has": [
        {
          "type": "host",
          "value": "blog.origamilab.com.br"
        }
      ],
      "destination": "https://www.origamilab.com.br/gestao-industrial-em-tempo-real#ia",
      "permanent": true
    },
    {
      "source": "/ia-na-mineracao{/}?",
      "has": [
        {
          "type": "host",
          "value": "blog.origamilab.com.br"
        }
      ],
      "destination": "https://www.origamilab.com.br/tecnologia-para-industrias-minas-gerais#cal-calcario",
      "permanent": true
    },
    {
      "source": "/category/inovacao-estrategia{/}?",
      "has": [
        {
          "type": "host",
          "value": "blog.origamilab.com.br"
        }
      ],
      "destination": "https://www.origamilab.com.br/consultoria-estrategica",
      "permanent": true
    },
    {
      "source": "/category/produto{/}?",
      "has": [
        {
          "type": "host",
          "value": "blog.origamilab.com.br"
        }
      ],
      "destination": "https://www.origamilab.com.br/unificacao-de-produtos-digitais",
      "permanent": true
    },
    {
      "source": "/author/victor-couto{/}?",
      "has": [
        {
          "type": "host",
          "value": "blog.origamilab.com.br"
        }
      ],
      "destination": "https://www.origamilab.com.br/#quem-somos",
      "permanent": true
    },
    {
      "source": "/blog{/}?",
      "has": [
        {
          "type": "host",
          "value": "blog.origamilab.com.br"
        }
      ],
      "destination": "https://www.origamilab.com.br/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "blog.origamilab.com.br"
        }
      ],
      "destination": "https://www.origamilab.com.br/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "blog.origamilab.com.br"
        }
      ],
      "destination": "https://www.origamilab.com.br/:path*",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/#quem-somos",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/(.*).(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*).(webp|jpg|jpeg|png|svg|webm|woff2|avif|gif|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
